---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/common/Icon.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface RelatedPost {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  pubDate: Date;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  readingTime: number;
  image?: string;
  headings?: Heading[];
  relatedPosts?: RelatedPost[];
}

const { title, description, pubDate, updatedDate, tags, readingTime, image, headings = [], relatedPosts = [] } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(pubDate);

const formattedUpdated = updatedDate
  ? new Intl.DateTimeFormat('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' }).format(updatedDate)
  : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const shareText = encodeURIComponent(title);
const shareURL = encodeURIComponent(canonicalURL);

const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={title} description={description} image={image} type="article" pubDate={pubDate} updatedDate={updatedDate} tags={tags}>

  <!-- Barra de progresso de leitura -->
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-primary-600 z-50 transition-[width] duration-150 ease-out" style="width:0%"></div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">

    <!-- Voltar ao blog -->
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-sm text-neutral-500 hover:text-primary-600 transition-colors mb-10 group"
    >
      <Icon name="arrow-left" class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" />
      Voltar ao blog
    </a>

    <!-- Header do post -->
    <header class="mb-10">
      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-5">
        {tags.map((tag) => (
          <a href={`/blog/tags/${tag}`} class="inline-flex items-center rounded-full bg-primary-100 px-3 py-1 text-xs font-medium text-primary-700 hover:bg-primary-200 transition-colors">
            {tag}
          </a>
        ))}
      </div>

      <!-- Título -->
      <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 leading-tight mb-6">
        {title}
      </h1>

      <!-- Meta info -->
      <div class="flex flex-wrap items-center gap-5 text-sm text-neutral-500 pb-8 border-b border-neutral-200">
        <div class="flex items-center gap-1.5">
          <Icon name="calendar" class="w-4 h-4" />
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        </div>

        <div class="flex items-center gap-1.5">
          <Icon name="clock" class="w-4 h-4" />
          <span>{readingTime} min de leitura</span>
        </div>

        {formattedUpdated && (
          <div class="flex items-center gap-1.5">
            <Icon name="refresh" class="w-4 h-4" />
            <span>Atualizado em {formattedUpdated}</span>
          </div>
        )}
      </div>

      <!-- Autoria -->
      <div class="mt-5 flex items-center gap-2 text-sm text-neutral-400">
        <Icon name="user" class="w-4 h-4 shrink-0" />
        <span>Por <span class="font-medium text-neutral-500">Danilo Silva</span></span>
        <span class="text-neutral-300" aria-hidden="true">&middot;</span>
        <span class="italic">Revisado pela IA</span>
      </div>
    </header>

    <!-- Índice do artigo -->
    {tocHeadings.length > 0 && (
      <nav class="mb-10 rounded-xl border border-neutral-200 bg-neutral-50 p-5" aria-label="Índice do artigo">
        <details>
          <summary class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-neutral-700 select-none">
            <Icon name="list" class="w-4 h-4" />
            Índice
          </summary>
          <ul class="mt-3 space-y-1.5 text-sm">
            {tocHeadings.map((h) => (
              <li class:list={[h.depth === 3 && "ml-4"]}>
                <a href={`#${h.slug}`} class="text-neutral-500 hover:text-primary-600 transition-colors">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    )}

    <!-- Conteúdo do post -->
    <div class="prose">
      <slot />
    </div>

    <!-- Rodapé do post -->
    <footer class="mt-14 pt-8 border-t border-neutral-200 flex items-center justify-between gap-4 flex-wrap">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm text-neutral-500 hover:text-primary-600 transition-colors group"
      >
        <Icon name="arrow-left" class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" />
        Ver mais artigos
      </a>

      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a href={`/blog/tags/${tag}`} class="inline-flex items-center rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700 hover:bg-primary-100 hover:text-primary-700 transition-colors">
            {tag}
          </a>
        ))}
      </div>
    </footer>

    <!-- Botões de compartilhamento -->
    <div class="mt-8 pt-8 border-t border-neutral-200">
      <p class="text-sm font-semibold text-neutral-700 mb-3 flex items-center gap-2">
        <Icon name="share" class="w-4 h-4" />
        Compartilhar
      </p>
      <div class="flex gap-3">
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareURL}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-[#0A66C2] px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity"
          aria-label="Compartilhar no LinkedIn"
        >
          <Icon name="linkedin" class="w-4 h-4" />
          LinkedIn
        </a>
        <a
          href={`https://wa.me/?text=${shareText}%20${shareURL}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity"
          aria-label="Compartilhar no WhatsApp"
        >
          <Icon name="whatsapp" class="w-4 h-4" />
          WhatsApp
        </a>
        <button
          id="copy-link-btn"
          class="inline-flex items-center gap-2 rounded-lg border border-neutral-300 bg-white px-4 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition-colors"
          aria-label="Copiar link do artigo"
        >
          <Icon name="copy" class="w-4 h-4" />
          Copiar link
        </button>
      </div>
    </div>

    <!-- Posts relacionados -->
    {relatedPosts.length > 0 && (
      <div class="mt-12 pt-8 border-t border-neutral-200">
        <h2 class="text-xl font-bold text-neutral-900 mb-6">Posts relacionados</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedPosts.map((related) => (
            <a href={`/blog/${related.slug}`} class="group rounded-xl border border-neutral-200 p-4 hover:border-primary-300 hover:shadow-md transition-all">
              <h3 class="text-sm font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors line-clamp-2 mb-2">
                {related.title}
              </h3>
              <p class="text-xs text-neutral-500 line-clamp-2 mb-3">{related.description}</p>
              <div class="flex flex-wrap gap-1">
                {related.tags.slice(0, 2).map((tag) => (
                  <span class="inline-flex rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600">{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Giscus Comments -->
    <div class="mt-12 pt-8 border-t border-neutral-200">
      <h2 class="text-xl font-bold text-neutral-900 mb-6">Comentários</h2>
      <div id="giscus-container"></div>
    </div>

  </div>

  <!-- Lightbox -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-label="Imagem ampliada" style="display:none" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm p-4 cursor-zoom-out">
    <button id="lightbox-close" aria-label="Fechar imagem" class="absolute top-4 right-4 text-white/70 hover:text-white transition-colors">
      <Icon name="close" class="w-8 h-8" />
    </button>
    <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[90vh] rounded-xl shadow-2xl object-contain cursor-default" />
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      // Barra de progresso de leitura
      const progressBar = document.getElementById('reading-progress');
      if (progressBar) {
        const updateProgress = () => {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          progressBar.style.width = `${Math.min(progress, 100)}%`;
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }

      // Copiar link
      const copyBtn = document.getElementById('copy-link-btn');
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          await navigator.clipboard.writeText(window.location.href);
          const original = copyBtn.textContent;
          copyBtn.textContent = 'Copiado!';
          setTimeout(() => { copyBtn.textContent = original; }, 2000);
        });
      }

      // Giscus
      const container = document.getElementById('giscus-container');
      if (container) {
        container.innerHTML = '';
        const script = document.createElement('script');
        script.src = 'https://giscus.app/client.js';
        script.setAttribute('data-repo', 'ddcsilva/dstech');
        script.setAttribute('data-repo-id', 'R_kgDORHSvSA');
        script.setAttribute('data-category', 'General');
        script.setAttribute('data-category-id', 'DIC_kwDORHSvSM4C4ps5');
        script.setAttribute('data-mapping', 'pathname');
        script.setAttribute('data-strict', '0');
        script.setAttribute('data-reactions-enabled', '1');
        script.setAttribute('data-emit-metadata', '0');
        script.setAttribute('data-input-position', 'bottom');
        script.setAttribute('data-theme', 'light');
        script.setAttribute('data-lang', 'pt');
        script.setAttribute('crossorigin', 'anonymous');
        script.async = true;
        container.appendChild(script);
      }

      // Lightbox
      const lightbox = document.getElementById('lightbox') as HTMLElement;
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
      if (!lightbox || !lightboxImg) return;

      function openLightbox(src: string, alt: string) {
        lightboxImg.src = src;
        lightboxImg.alt = alt;
        lightbox.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        lightbox.style.display = 'none';
        document.body.style.overflow = '';
      }

      document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
        img.style.cursor = 'zoom-in';
        img.addEventListener('click', () => openLightbox(img.src, img.alt));
      });

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      });
    });
  </script>
</BaseLayout>
