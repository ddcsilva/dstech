---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/seo/BaseHead.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { title, description, image, canonicalURL, type, pubDate, updatedDate, tags } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      canonicalURL={canonicalURL}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-neutral-900 antialiased">
    <a href="#main-content" class="skip-link">
      Pular para conteúdo principal
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
