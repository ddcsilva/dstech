---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/common/Section.astro';
import Card from '../components/common/Card.astro';
import Button from '../components/common/Button.astro';
import Icon from '../components/common/Icon.astro';
import navigation from '../data/navigation.json';
---

<BaseLayout
  title="Contato"
  description="Entre em contato com Danilo Silva para networking e oportunidades profissionais. Conecte-se pelo LinkedIn ou GitHub."
>
  <!-- Hero -->
  <section class="bg-linear-to-b from-primary-50 to-white py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl">
        <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 mb-6">
          Contato
        </h1>
        <p class="text-lg text-neutral-600 leading-relaxed">
          Estou sempre aberto para networking e trocar ideias sobre tecnologia. Conecte-se comigo pelas redes abaixo.
        </p>
      </div>
    </div>
  </section>

  <!-- Links de Contato -->
  <Section>
    <div class="max-w-3xl mx-auto">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {navigation.social.map((social) => (
          <Card class="text-center">
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mb-4">
                <Icon name={social.icon as any} class="w-8 h-8 text-primary-600" />
              </div>
              <h3 class="text-lg font-semibold text-neutral-900 mb-2">
                {social.label}
              </h3>
              <p class="text-sm text-neutral-500 mb-4">
                {social.icon === 'linkedin' && 'Conecte-se para networking profissional'}
                {social.icon === 'github' && 'Veja meus projetos e contribuições'}
              </p>
              <Button href={social.href} variant="primary" size="md" external>
                Acessar {social.label}
              </Button>
            </div>
          </Card>
        ))}
      </div>

      <!-- Formulário de Contato -->
      <div class="mt-12 pt-12 border-t border-neutral-200">
        <h2 class="text-2xl font-bold text-neutral-900 mb-2 text-center">Envie uma mensagem</h2>
        <p class="text-neutral-600 mb-8 text-center">Preencha o formulário abaixo e retornarei o mais breve possível.</p>

        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-6 max-w-lg mx-auto" id="contact-form">
          <input type="hidden" name="access_key" value="03f16f09-87e0-46dd-986a-8561a1479f23" />
          <input type="hidden" name="subject" value="Novo contato via DStech" />
          <input type="hidden" name="from_name" value="DStech Website" />
          <div class="sr-only" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div>
            <label for="name" class="block text-sm font-medium text-neutral-700 mb-1">Nome</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-neutral-900 placeholder-neutral-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 outline-none transition"
              placeholder="Seu nome"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-neutral-700 mb-1">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-neutral-900 placeholder-neutral-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 outline-none transition"
              placeholder="seu@email.com"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-neutral-700 mb-1">Mensagem</label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-neutral-900 placeholder-neutral-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 outline-none transition resize-y"
              placeholder="Escreva sua mensagem..."
            ></textarea>
          </div>

          <div>
            <Button type="submit" variant="primary" size="lg" class="w-full justify-center">
              Enviar mensagem
            </Button>
          </div>

          <div id="form-result" class="text-center text-sm font-medium hidden"></div>
        </form>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const result = document.getElementById('form-result');
    if (form && result) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        result.className = 'text-center text-sm font-medium';
        result.textContent = 'Enviando...';

        const response = await fetch(form.action, {
          method: form.method,
          body: new FormData(form),
        });

        if (response.ok) {
          result.className = 'text-center text-sm font-medium text-green-600';
          result.textContent = 'Mensagem enviada com sucesso! Obrigado pelo contato.';
          form.reset();
        } else {
          result.className = 'text-center text-sm font-medium text-red-600';
          result.textContent = 'Erro ao enviar. Tente novamente ou use o email diretamente.';
        }
      });
    }
  });
</script>
