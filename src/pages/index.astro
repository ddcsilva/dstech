---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/common/Section.astro';
import Card from '../components/common/Card.astro';
import Badge from '../components/common/Badge.astro';
import Button from '../components/common/Button.astro';
import Icon from '../components/common/Icon.astro';
import projects from '../data/projects.json';

const featuredProjects = projects.projects.filter((p) => p.featured).slice(0, 3);

const specialties = [
  {
    title: 'Arquitetura Backend',
    description: '.NET, Java, Spring Boot, Clean Architecture, CQRS, arquitetura hexagonal, microserviços, BFF e APIs REST de alta performance e escalabilidade.',
    icon: 'server' 
  },
  {
    title: 'Frontend Enterprise',
    description: 'Angular, Micro-frontends, TypeScript, componentização escalável e padrões modernos.',
    icon: 'layout'
  },
  {
    title: 'Modernização de Legados',
    description: 'Migração de sistemas ASP, VB, WPF para arquiteturas modernas com governança.',
    icon: 'refresh'
  },
  {
    title: 'Cloud & DevOps',
    description: 'AWS, Azure, Docker, pipelines CI/CD, automação e boas práticas de deploy.',
    icon: 'cloud'
  }
];
---

<BaseLayout
  title="Home"
  description="Site pessoal de Danilo Silva, Engenheiro de Software Sênior com quase 20 anos de experiência em TI, especializado em .NET, Angular e modernização de sistemas."
>
  <!-- Hero -->
  <section class="bg-linear-to-b from-primary-50 to-white py-20 sm:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-neutral-900 mb-6">
        Danilo Silva
      </h1>
      <p class="text-xl sm:text-2xl text-neutral-600 mb-2">
        Engenheiro de Software Sênior
      </p>
      <p class="text-base sm:text-lg text-neutral-500 mb-4">
        .NET, Java & Angular | Modernização de Sistemas | Cloud (AWS/Azure)
      </p>
      <p class="text-lg text-neutral-600 max-w-2xl mx-auto mb-8 leading-relaxed">
        Quase 20 anos em TI, mais de 13 dedicados ao desenvolvimento e arquitetura de software.
        Especialista em modernização de legados, arquitetura limpa e entrega de soluções escaláveis.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/sobre" size="lg">
          Conhecer trajetória
        </Button>
        <Button href="/projetos" variant="secondary" size="lg">
          Ver projetos
        </Button>
      </div>
    </div>
  </section>

  <!-- Especialidades -->
  <Section
    title="Áreas de Especialidade"
    subtitle="Conhecimento técnico construído ao longo de duas décadas em projetos de grande porte"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {specialties.map((specialty) => (
        <Card>
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center">
              <Icon name={specialty.icon as any} class="w-6 h-6 text-primary-600" />
            </div>
            <div>
              <h3 class="text-lg font-semibold text-neutral-900 mb-2">
                {specialty.title}
              </h3>
              <p class="text-neutral-600">
                {specialty.description}
              </p>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <!-- Projetos em Destaque -->
  <Section
    title="Projetos em Destaque"
    subtitle="Iniciativas pessoais e voluntarias"
    class="bg-neutral-50"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      {featuredProjects.map((project) => (
        <Card class="h-full flex flex-col">
          <div class="flex items-start justify-between gap-2 mb-3">
            <h3 class="text-lg font-semibold text-neutral-900">
              {project.title}
            </h3>
            <Badge variant={project.type === 'volunteer' ? 'info' : 'primary'} size="sm">
              {project.type === 'volunteer' ? 'Voluntário' : 'Pessoal'}
            </Badge>
          </div>
          <p class="text-neutral-600 text-sm mb-4 flex-1">
            {project.description}
          </p>
          <div class="flex flex-wrap gap-2">
            {project.tags.slice(0, 3).map((tag) => (
              <Badge size="sm">{tag}</Badge>
            ))}
          </div>
        </Card>
      ))}
    </div>
    <div class="text-center">
      <Button href="/projetos" variant="secondary">
        Ver todos os projetos
      </Button>
    </div>
  </Section>

  <!-- CTA -->
  <Section class="bg-primary-600 text-white">
    <div class="text-center">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4">
        Quer conhecer mais sobre minha trajetória?
      </h2>
      <p class="text-primary-100 mb-8 max-w-xl mx-auto">
        Acesse meu currículo completo ou conecte-se comigo no LinkedIn para trocar ideias sobre tecnologia.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/cv" variant="secondary" size="lg" class="bg-white text-primary-600 hover:bg-primary-50">
          Ver CV completo
        </Button>
        <Button href="/contato" variant="ghost" size="lg" class="text-white hover:bg-primary-500">
          Conectar-se
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
