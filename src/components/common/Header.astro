---
import navigation from '../../data/navigation.json';
import Icon from './Icon.astro';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-neutral-200">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Navegação principal">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a
        href="/"
        class="font-bold text-xl text-primary-600 hover:text-primary-700 transition-colors"
        aria-label="DStech - Página inicial"
      >
        DS<span class="text-neutral-400">tech</span>
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex items-center gap-1" role="list">
        {navigation.items.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "px-4 py-2 rounded-lg text-sm font-medium transition-colors",
                (currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href + '/')))
                  ? "bg-primary-50 text-primary-700"
                  : "text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100"
              ]}
              aria-current={(currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href + '/'))) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="md:hidden p-2 rounded-lg text-neutral-600 hover:bg-neutral-100 transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-haspopup="true"
        aria-label="Abrir menu de navegação"
        id="mobile-menu-button"
      >
        <Icon name="menu" class="w-6 h-6" />
      </button>
    </div>

  </nav>
</header>

<div
  id="mobile-menu-backdrop"
  class="md:hidden fixed inset-0 z-40 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<div
  id="mobile-menu"
  class="md:hidden fixed inset-y-0 right-0 z-50 w-full max-w-sm bg-white shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out"
  role="dialog"
  aria-modal="true"
  aria-label="Menu de navegação"
  aria-hidden="true"
>
  <div class="flex items-center justify-between h-16 px-4 border-b border-neutral-200">
    <a href="/" class="font-bold text-xl text-primary-600">
      DS<span class="text-neutral-400">tech</span>
    </a>
    <button
      type="button"
      class="p-2 rounded-lg text-neutral-600 hover:bg-neutral-100 transition-colors"
      aria-label="Fechar menu"
      id="mobile-menu-close"
    >
      <Icon name="close" class="w-6 h-6" />
    </button>
  </div>
  <ul class="px-4 py-6 space-y-2" role="list">
    {navigation.items.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={[
            "block px-4 py-3 rounded-lg text-lg font-medium transition-colors",
            (currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href + '/')))
              ? "bg-primary-50 text-primary-700"
              : "text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100"
          ]}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
  <div class="px-4 pt-6 border-t border-neutral-200">
    <p class="text-sm text-neutral-500 mb-4">Conecte-se</p>
    <div class="flex gap-4">
      {navigation.social.map((social) => (
        <a
          href={social.href}
          class="text-neutral-600 hover:text-primary-600 transition-colors"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
        >
          <Icon name={social.icon as any} class="w-6 h-6" />
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  // Usamos 'astro:page-load' para que os listeners sejam re-registrados após cada
  // navegação do ClientRouter (View Transitions). Sem isso, após trocar de página
  // os elementos do DOM são substituídos e os listeners originais se perdem.
  document.addEventListener('astro:page-load', () => {
    const menuButton = document.getElementById('mobile-menu-button');
    const menuClose = document.getElementById('mobile-menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-menu-backdrop');

    let focusableElements: HTMLElement[] = [];
    let firstFocusable: HTMLElement | null = null;
    let lastFocusable: HTMLElement | null = null;
    let previousActiveElement: HTMLElement | null = null;

    function preventScroll(e: TouchEvent) {
      e.preventDefault();
    }

    function openMenu() {
      if (!mobileMenu || !backdrop) return;

      previousActiveElement = document.activeElement as HTMLElement;

      mobileMenu.classList.remove('translate-x-full');
      mobileMenu.classList.add('translate-x-0');
      mobileMenu.setAttribute('aria-hidden', 'false');

      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');

      menuButton?.setAttribute('aria-expanded', 'true');

      document.body.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.width = '100%';
      document.body.style.top = `-${window.scrollY}px`;

      document.addEventListener('touchmove', preventScroll, { passive: false });

      setupFocusTrap();

      setTimeout(() => {
        menuClose?.focus();
      }, 100);
    }

    function closeMenu() {
      if (!mobileMenu || !backdrop) return;

      mobileMenu.classList.remove('translate-x-0');
      mobileMenu.classList.add('translate-x-full');
      mobileMenu.setAttribute('aria-hidden', 'true');

      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');

      menuButton?.setAttribute('aria-expanded', 'false');

      const scrollY = document.body.style.top;
      document.body.style.overflow = '';
      document.body.style.position = '';
      document.body.style.width = '';
      document.body.style.top = '';
      window.scrollTo(0, parseInt(scrollY || '0') * -1);

      document.removeEventListener('touchmove', preventScroll);

      previousActiveElement?.focus();
    }

    function setupFocusTrap() {
      if (!mobileMenu) return;

      focusableElements = Array.from(
        mobileMenu.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'
        )
      );

      firstFocusable = focusableElements[0] || null;
      lastFocusable = focusableElements[focusableElements.length - 1] || null;
    }

    function handleKeydown(e: KeyboardEvent) {
      // Escape fecha o menu
      if (e.key === 'Escape' && mobileMenu?.classList.contains('translate-x-0')) {
        closeMenu();
        return;
      }

      // Focus trap
      if (e.key !== 'Tab' || !mobileMenu?.classList.contains('translate-x-0')) return;

      if (e.shiftKey) {
        if (document.activeElement === firstFocusable) {
          e.preventDefault();
          lastFocusable?.focus();
        }
      } else {
        if (document.activeElement === lastFocusable) {
          e.preventDefault();
          firstFocusable?.focus();
        }
      }
    }

    menuButton?.addEventListener('click', openMenu);
    menuClose?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);
    document.addEventListener('keydown', handleKeydown);

    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && mobileMenu?.classList.contains('translate-x-0')) {
        closeMenu();
      }
    });
  });
</script>
