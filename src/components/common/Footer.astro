---
import Icon from './Icon.astro';
import navigation from '../../data/navigation.json';

const currentYear = new Date().getFullYear();
---

<footer class="bg-neutral-900 text-neutral-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Brand -->
      <div>
        <a href="/" class="font-bold text-xl text-white">
          DS<span class="text-neutral-500">tech</span>
        </a>
        <p class="mt-4 text-sm text-neutral-400 leading-relaxed">
          Engenheiro de Software Sênior com foco em arquitetura .NET, Angular e modernização de sistemas legados.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="font-semibold text-white mb-4">Navegação</h3>
        <ul class="space-y-2" role="list">
          {navigation.items.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-neutral-400 hover:text-white transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h3 class="font-semibold text-white mb-4">Conecte-se</h3>
        <ul class="space-y-2" role="list">
          {navigation.social.map((social) => (
            <li>
              <a
                href={social.href}
                class="inline-flex items-center gap-2 text-sm text-neutral-400 hover:text-white transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name={social.icon as any} class="w-4 h-4" />
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-neutral-800 pt-8 mt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-neutral-500">
      <p>&copy; {currentYear} Danilo Silva. Todos os direitos reservados.</p>
      <p class="flex items-center gap-1">
        Feito com
        <Icon name="heart" class="w-4 h-4 text-red-500" />
        usando Astro + Tailwind
      </p>
    </div>
  </div>
</footer>
